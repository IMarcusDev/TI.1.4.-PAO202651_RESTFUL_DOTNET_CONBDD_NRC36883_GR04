<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette taken from the web client (wwwroot/css/eurekabank.css). -->
    <SolidColorBrush x:Key="Marca900" Color="#0B2545" />
    <SolidColorBrush x:Key="Marca700" Color="#13315C" />
    <SolidColorBrush x:Key="Marca500" Color="#1D4E89" />
    <SolidColorBrush x:Key="Marca100" Color="#E3ECF7" />
    <SolidColorBrush x:Key="Gris900" Color="#1F2933" />
    <SolidColorBrush x:Key="Gris600" Color="#52606D" />
    <SolidColorBrush x:Key="Gris300" Color="#CBD2D9" />
    <SolidColorBrush x:Key="Gris100" Color="#F5F7FA" />
    <SolidColorBrush x:Key="Blanco" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Peligro600" Color="#C62828" />
    <SolidColorBrush x:Key="Peligro50" Color="#FDECEA" />
    <SolidColorBrush x:Key="Exito600" Color="#2E7D32" />
    <SolidColorBrush x:Key="Exito50" Color="#E8F5E9" />
    <SolidColorBrush x:Key="ServicioRest" Color="#B45309" />
    <SolidColorBrush x:Key="ServicioDotnet" Color="#5B21B6" />
    <SolidColorBrush x:Key="EstadoDisponible" Color="#15803D" />
    <SolidColorBrush x:Key="EstadoNoDisponible" Color="#B91C1C" />

    <FontFamily x:Key="Fuente">Segoe UI</FontFamily>

    <!-- Shows an element only when its bound flag is true. -->
    <BooleanToVisibilityConverter x:Key="VisibleSi" />

    <!-- Typography -->
    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Marca900}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Marca900}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Gris600}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Cuerpo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Gris600}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Peligro600}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Ayuda" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Gris600}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ValorRecibo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Marca500}" />
        <Setter Property="BorderBrush" Value="{StaticResource Marca500}" />
        <Setter Property="Foreground" Value="{StaticResource Blanco}" />
    </Style>
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource Marca500}" />
        <Setter Property="Foreground" Value="{StaticResource Marca500}" />
    </Style>
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Peligro600}" />
        <Setter Property="BorderBrush" Value="{StaticResource Peligro600}" />
        <Setter Property="Foreground" Value="{StaticResource Blanco}" />
    </Style>
    <Style x:Key="BotonEnlace" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Marca700}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="BotonNavegacion" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Home cards: a whole card is one button. -->
    <Style x:Key="BotonTarjeta" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tarjeta"
                            Background="{StaticResource Blanco}"
                            BorderBrush="{StaticResource Gris300}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Marca500}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Tarjeta" Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style x:Key="Campo" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gris300}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Marca500}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Gris100}" />
                <Setter Property="Foreground" Value="{StaticResource Gris600}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CampoClave" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gris300}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Marca500}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Gris100}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OpcionRol" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gris300}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="AlertaError" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Peligro50}" />
        <Setter Property="BorderBrush" Value="{StaticResource Peligro600}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="AlertaExito" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Exito50}" />
        <Setter Property="BorderBrush" Value="{StaticResource Exito600}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="AlertaInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Marca100}" />
        <Setter Property="BorderBrush" Value="{StaticResource Marca500}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Movement table -->
    <Style x:Key="EncabezadoTabla" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Gris100}" />
        <Setter Property="Foreground" Value="{StaticResource Marca900}" />
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Gris300}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="CeldaTabla" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Gris900}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tabla" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Gris300}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gris300}" />
        <Setter Property="Background" Value="{StaticResource Blanco}" />
        <Setter Property="RowBackground" Value="{StaticResource Blanco}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="{StaticResource Fuente}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EncabezadoTabla}" />
        <Setter Property="CellStyle" Value="{StaticResource CeldaTabla}" />
    </Style>

</ResourceDictionary>
