<Window x:Class="ec.edu.monster.vista.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:ec.edu.monster.vista.controles"
        xmlns:vista="clr-namespace:ec.edu.monster.vista"
        xmlns:modelos="clr-namespace:ec.edu.monster.vista.modelos"
        Title="EurekaBank"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Gris100}"
        FontFamily="{StaticResource Fuente}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type modelos:MenuViewModel}">
            <vista:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type modelos:OperacionViewModel}">
            <vista:OperacionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type modelos:MovimientosViewModel}">
            <vista:MovimientosView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Marca900}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        CornerRadius="9"
                        Background="{StaticResource Marca500}"
                        VerticalAlignment="Center">
                    <TextBlock Text="EB"
                               Foreground="{StaticResource Blanco}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="EurekaBank"
                                   Foreground="{StaticResource Blanco}"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Border Background="{StaticResource ServicioRest}"
                                CornerRadius="9"
                                Padding="8,2"
                                Margin="10,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="REST"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <Border Background="{StaticResource ServicioDotnet}"
                                CornerRadius="9"
                                Padding="8,2"
                                Margin="6,2,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text=".NET"
                                       Foreground="{StaticResource Blanco}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Banca en línea · Servicio RESTful / .NET"
                               Foreground="{StaticResource Marca100}"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Sesion.NombreVisible}"
                                   Foreground="{StaticResource Blanco}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Sesion.TipoUsuario}"
                                   Foreground="{StaticResource Marca100}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Cerrar sesión"
                            Style="{StaticResource BotonSecundario}"
                            Padding="14,7"
                            Click="CerrarSesion" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + content host -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Blanco}"
                    BorderBrush="{StaticResource Gris300}"
                    BorderThickness="0,0,1,0"
                    Padding="16,20">
                <StackPanel>
                    <TextBlock Text="MENÚ"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="14,0,0,10" />
                    <Button Content="Inicio"
                            Style="{StaticResource BotonNavegacion}"
                            Command="{Binding MostrarMenuCommand}" />
                    <Button Content="Consultar movimientos"
                            Style="{StaticResource BotonNavegacion}"
                            Command="{Binding Menu.AbrirCommand}"
                            CommandParameter="movimientos" />
                    <Button Content="Depósito"
                            Style="{StaticResource BotonNavegacion}"
                            IsEnabled="{Binding Menu.PuedeDepositar}"
                            Command="{Binding Menu.AbrirCommand}"
                            CommandParameter="deposito" />
                    <Button Content="Retiro"
                            Style="{StaticResource BotonNavegacion}"
                            Command="{Binding Menu.AbrirCommand}"
                            CommandParameter="retiro" />
                    <Button Content="Transferencia"
                            Style="{StaticResource BotonNavegacion}"
                            Command="{Binding Menu.AbrirCommand}"
                            CommandParameter="transferencia" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding Contenido}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Blanco}"
                BorderBrush="{StaticResource Gris300}"
                BorderThickness="0,1,0,0"
                Padding="28,10">
            <controles:IndicadorEstado x:Name="IndicadorEstadoControl" />
        </Border>
    </Grid>
</Window>
