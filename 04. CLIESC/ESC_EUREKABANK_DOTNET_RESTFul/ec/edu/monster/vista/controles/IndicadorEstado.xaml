<UserControl x:Class="ec.edu.monster.vista.controles.IndicadorEstado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Fuente}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource Gris300}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Estado}" Value="up">
                            <Setter Property="Fill" Value="{StaticResource EstadoDisponible}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Estado}" Value="down">
                            <Setter Property="Fill" Value="{StaticResource EstadoNoDisponible}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding Texto}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
