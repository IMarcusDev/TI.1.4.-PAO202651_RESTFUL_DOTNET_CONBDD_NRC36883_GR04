<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta institucional: azul marino y grises (RNF-009), igual que el cliente Android -->
    <Color x:Key="EurekaPrimario">#344C74</Color>
    <Color x:Key="EurekaPrimarioOscuro">#22365A</Color>
    <Color x:Key="EurekaPrimarioSuave">#E9EEF6</Color>
    <Color x:Key="FondoApp">#F3F4F6</Color>
    <Color x:Key="Blanco">#FFFFFF</Color>
    <Color x:Key="TextoOscuro">#1F2937</Color>
    <Color x:Key="TextoSecundario">#6B7280</Color>
    <Color x:Key="BordeCampo">#8A8F98</Color>
    <Color x:Key="BordeTarjeta">#E2E5EA</Color>
    <Color x:Key="TextoSobrePrimario">#D5DCE8</Color>
    <Color x:Key="Ingreso">#157F4A</Color>
    <Color x:Key="IngresoFondo">#E3F5EA</Color>
    <Color x:Key="Salida">#B42318</Color>
    <Color x:Key="SalidaFondo">#FDECEA</Color>
    <Color x:Key="TextoError">#C62828</Color>
    <Color x:Key="ErrorFondo">#FDECEA</Color>
    <Color x:Key="BlancoTranslucido">#26FFFFFF</Color>

    <LinearGradientBrush x:Key="GradientePrimario" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22365A" Offset="0" />
        <GradientStop Color="#344C74" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
        <Setter Property="Stroke" Value="{StaticResource BordeTarjeta}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="TarjetaPrimaria" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GradientePrimario}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="TituloSeccion" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor" Value="{StaticResource TextoOscuro}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="Secundario" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.7" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
    </Style>

    <Style x:Key="Pastilla" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TextoPastilla" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource EurekaPrimario}" />
        <Setter Property="TextColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#8C9AB3" />
                            <Setter Property="TextColor" Value="{StaticResource Blanco}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BotonTexto" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource EurekaPrimario}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="BotonContorno" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Blanco}" />
        <Setter Property="BorderColor" Value="{StaticResource TextoSobrePrimario}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

</ResourceDictionary>
