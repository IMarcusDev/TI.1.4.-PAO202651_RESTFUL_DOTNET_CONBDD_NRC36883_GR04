@model OperacionVista
@*
  Withdrawal view. Rendered by RetiroController (GET/POST /retiro); Model.Vista selects the state:
  formulario, confirmacion or comprobante. A Cliente sees their own account read-only and is not
  asked for the key.
  Design: Figma "EurekaBank - Plantillas UI", frames "Web · Transferencia (Empleado)",
  "Web · Confirmación" and "Web · Comprobante".
*@
@{
    ViewData["Title"] = "Retiro";
    ViewData["ActiveNav"] = "retiro";
}
@section Estilos {
    <link rel="stylesheet" href="~/css/operacion.css">
}
<div class="content__title">
    <h1 class="text-heading-xl">Retiro</h1>
    <p class="text-body">Registrar una salida de una cuenta</p>
</div>

@if (Model.Vista == OperacionVista.Comprobante)
{
    <partial name="_Recibo" model="@(new ReciboVista(Model, "~/retiro", [
        ("Operación", "operacion"),
        ("Cuenta", "cuenta"),
        ("Importe", "importe"),
        ("N.º de movimiento", "idMovimiento"),
        ("Nuevo saldo", "nuevoSaldo"),
        ("Fecha", "fecha"),
    ]))" />
}
else if (Model.Vista == OperacionVista.Confirmacion)
{
    <section class="op-dialog" aria-labelledby="confirmar-title">
        <h2 id="confirmar-title" class="op-dialog__title">Confirmar retiro</h2>
        <p class="op-dialog__text">
            ¿Retirar <strong>@Model.ImporteFormateado</strong>
            de la cuenta <strong>@Model.Cuenta</strong>?
        </p>
        @* Hidden values are validated again by the controller *@
        <form class="op-form" method="post" action="~/retiro" asp-antiforgery="true">
            <input type="hidden" name="cuenta" value="@Model.Cuenta">
            <input type="hidden" name="importe" value="@Model.Importe">
            @if (!Model.EsCliente)
            {
                <partial name="_Clave" model="@(new ClaveVista("Clave de la cuenta", Model.ErrorDe("clave")))" />
            }
            <div class="op-actions">
                <button class="btn btn--secondary" type="submit" name="paso" value="editar">Volver</button>
                <button class="btn btn--danger" type="submit" name="paso" value="confirmar">Confirmar</button>
            </div>
        </form>
    </section>
}
else
{
    <form class="op-card" method="post" action="~/retiro" asp-antiforgery="true">
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="alert alert--error" role="alert">@Model.Error</p>
        }

        <partial name="_Campo" model="@(new CampoVista("cuenta", "Número de cuenta", Model.Cuenta, "Ingrese el número de cuenta", Model.ErrorDe("cuenta")) { SoloLectura = Model.EsCliente })" />
        <partial name="_Campo" model="@CampoVista.ImporteDe(Model)" />

        <div class="op-actions">
            <a class="btn btn--secondary" href="~/menu">Cancelar</a>
            <button class="btn btn--primary" type="submit" name="paso" value="revisar">Revisar</button>
        </div>
    </form>
}
